[Unit]
Description=Investing API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStartPre=-/bin/rm -f @ROOT@/data/investing.sock
ExecStart=%h/.local/bin/uv run --frozen --no-dev uvicorn investing.web.app:app --uds @ROOT@/data/investing.sock --proxy-headers --forwarded-allow-ips='*' --workers 1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-@ROOT@/.env
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
UMask=0002

[Install]
WantedBy=default.target
