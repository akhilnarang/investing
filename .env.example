# Copy to .env and fill in what you need. Every key is optional unless it says otherwise; the real
# environment wins over this file. On a server, create .env in the git checkout; it is gitignored.

# --- Everything -------------------------------------------------------------------------------------

# Sent on every outbound request. Defaults to desktop Chrome; NSE and KFintech's CDN reject
# non-browser agents.
# INVESTING_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"

# An env file to load instead of .env at the repo root. Only read from the process environment.
# INVESTING_ENV_FILE=/etc/investing.env

# Where the database and the raw-response caches live. Relative paths are taken from the repo root.
# INVESTING_DB=data/investing.sqlite3
# INVESTING_CACHE=~/.cache/investing

# Local addresses to spread rate-limited fetches over, comma separated, one exit each. Only useful on
# a machine with several public IPs; unset means one direct exit. See src/investing/core/egress.py.
# INVESTING_ADDRESSES=10.0.0.10,10.0.0.11

# --- Rate limits (per client address, in process) -----------------------------------------------------

# Written requests/seconds; a count of 0 turns the limit off. The client address comes from the
# header named here, which the reverse proxy must overwrite. Unset: the first X-Forwarded-For
# entry, which a client can forge.
# INVESTING_CLIENT_IP_HEADER=X-Real-IP
# Live NSE routes: /api/v1/slb/{symbol}, /api/v1/options/{symbol} and lookups on /slb.
# INVESTING_RATE_LIMIT_NSE=30/60
# POST /api/v1/ipo/allotment/lookup.
# INVESTING_RATE_LIMIT_ALLOTMENT=60/60
# POST /api/v1/ipo/analyze.
# INVESTING_RATE_LIMIT_ANALYZE=10/600

# --- IPO prospectus analyser (/ipo/rhp) ---------------------------------------------------------------

# Required to accept new analyses. Any OpenAI-compatible Responses endpoint works.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# RHP_DEFAULT_MODEL=gpt-5.6-terra
# RHP_DEFAULT_RETRIES=2
# Largest accepted PDF in bytes. Keep the proxy's client_max_body_size a little above it.
# RHP_MAX_PDF_BYTES=50000000
# RHP_SECTION_CONCURRENCY=4
# RHP_JOB_CONCURRENCY=1
# The database holding the prospectus tables. Defaults to the main database.
# RHP_DATABASE_PATH=data/investing.sqlite3

# Required to accept new analyses. Bearer tokens, comma separated. Unset: analysis is off.
# RHP_API_TOKENS=

# --- IPO allotment lookup (/ipo/allotment) -----------------------------------------------------------

# IPO_ALLOTMENT_TIMEOUT_SECONDS=15
# IPO_ALLOTMENT_CATALOGUE_TTL_SECONDS=300
# HTTP proxies for registrars that block datacenter addresses. KFintech's is used only to fetch the
# issue list, never for a PAN lookup. Purva's is used for every request; HTTPS is tunnelled, so the
# proxy never sees a PAN.
# KFINTECH_PROXY_URL=http://127.0.0.1:8888
# PURVA_PROXY_URL=http://127.0.0.1:8888

# --- coin-tradebook ------------------------------------------------------------------------------------

# Your Zerodha Console session. Optional: the tool prompts when these are unset. Never commit them.
# CONSOLE_COOKIE=
# CONSOLE_CSRF=

# --- scripts/deploy.sh (read from this file on the machine you deploy from) --------------------------

# DEPLOY_HOST=user@host
# DEPLOY_DEST=investing
# DEPLOY_BRANCH=main
# DEPLOY_REF=
# DEPLOY_SSH_OPTS="-o HostKeyAlias=myserver"
